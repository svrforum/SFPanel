{
  "id": "radarr",
  "name": "Radarr",
  "description": {
    "ko": "영화 자동 다운로드 및 관리 (PVR)",
    "en": "Movie PVR for automatic download and management"
  },
  "category": "media",
  "version": "1.0.0",
  "website": "https://radarr.video",
  "source": "https://github.com/Radarr/Radarr",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/radarr.svg",
  "ports": [7878],
