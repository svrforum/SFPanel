      "icon": "🎬"
    },
    {
      "title": { "ko": "품질 관리", "en": "Quality management" },
      "description": { "ko": "원하는 화질로 자동 업그레이드", "en": "Automatically upgrade to your preferred quality" },
      "icon": "🎚️"
    },
    {
      "title": { "ko": "라이브러리 관리", "en": "Library management" },
      "description": { "ko": "영화 라이브러리를 체계적으로 정리", "en": "Organize your movie library systematically" },
      "icon": "🗂️"
    }
  ],
  "env": [
    {
      "key": "PORT",
      "label": { "ko": "외부 포트", "en": "External Port" },
      "type": "port",
      "default": "7878"
    }
  ]
}
