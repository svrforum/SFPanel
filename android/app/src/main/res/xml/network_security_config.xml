<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN HTTP requires an explicit confirmation in the connection screen.
         Private CA installations use Android's user certificate store. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
